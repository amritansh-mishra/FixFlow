NODE_ENV=development
PORT=3000

# These defaults match the Docker database (docker compose up -d), so
# `cp .env.example .env` works as-is. The passwords are local-only.
#
# Using your own PostgreSQL instead? Point both URLs at it (usually port
# 5432) and follow README "Database users" to set up the fixflow_app role.

# The app connects as the restricted fixflow_app role.
DATABASE_URL=postgresql://fixflow_app:fixflow_app@localhost:5433/fixflow
# Migrations, schema tools and test setup connect as the table owner.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/fixflow

# Redis for background jobs (the Docker Compose one by default).
REDIS_URL=redis://localhost:6379

# Email: Mailpit (Docker Compose) by default; its inbox is http://localhost:8025.
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=FixFlow <no-reply@fixflow.local>
# The frontend's address, used for links in emails.
APP_URL=http://localhost:5173

# Frontend origins allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=http://localhost:5173
