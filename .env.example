NODE_ENV=development
PORT=3000
# The app connects as the restricted fixflow_app role (see README).
DATABASE_URL=postgresql://fixflow_app:password@localhost:5432/flixflow
# Migrations, schema tools and test setup connect as the table owner.
DATABASE_ADMIN_URL=postgresql://postgres:password@localhost:5432/flixflow
# Frontend origins allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=http://localhost:5173
