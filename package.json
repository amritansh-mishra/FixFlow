{
  "name": "fixflow",
  "version": "1.0.0",
  "type": "module",
  "description": "FixFlow replaces scattered WhatsApp messages, calls and spreadsheets with a structured maintenance workflow for apartment complexes, hostels, offices and college campuses.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "user:set-password": "tsx src/scripts/set-password.ts",
    "start:prod": "node dist/db/migrate.js && node dist/scripts/seed-demo.js && node dist/server.js",
    "db:seed-demo": "tsx src/scripts/seed-demo.ts",
    "worker": "tsx watch src/worker.ts",
    "worker:prod": "node dist/worker.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bullmq": "^6.3.11",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
